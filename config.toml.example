# ai_drawing_plugin - 自动生成的配置文件
# 基于 Stable Diffusion WebUI API 的 AI 绘图插件，为 MaiBot 提供强大的图像生成能力

# 插件基本配置
[plugin]

# 是否启用插件
enabled = false

# 配置文件版本
config_version = "2.3.0"

# 调试模式（启用后会在聊天中显示详细的 prompt 信息）
debug_mode = false


# Stable Diffusion API 配置
[api]

# Stable Diffusion WebUI API 地址
# 示例: http://localhost:7860
base_url = "http://localhost:7860"


# 图像生成参数配置
[generation]

# 质量提示词（只能在配置文件中修改，用于提升图像质量）
quality_prompt = "masterpiece, best quality, highly detailed"

# 内容提示词（可由 Action/Command 组件动态设置，描述图像内容）
content_prompt = ""

# 默认负面提示词（使用权重语法如 (word:1.5) 可增强效果）
negative_prompt = "(nsfw:1.5), (nude:1.5), (explicit:1.5), lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, normal quality, jpeg artifacts, signature, watermark, username, blurry"

# 图像宽度（像素）
width = 512

# 图像高度（像素）
height = 512

# 采样步数
steps = 20

# 提示词相关性
cfg_scale = 7.0

# 采样器名称
# 示例: DPM++ 2M Karras
sampler_name = "Euler a"

# 调度器类型（留空使用默认）
# 示例: Karras
scheduler = ""

# 是否启用高分修复
enable_hr = false

# 高分修复放大倍数
hr_scale = 2.0

# 高分修复使用的放大器
# 示例: R-ESRGAN 4x+
hr_upscaler = "Latent"

# 去噪强度（用于高分修复）
denoising_strength = 0.7

# 可用的采样器列表（用于命令切换）
available_samplers = [
    "Euler a",
    "Euler",
    "DPM++ 2M Karras",
    "DPM++ SDE Karras",
    "DPM++ 2M SDE",
    "DDIM",
    "LMS"
]

# 可用的调度器列表（用于命令切换）
available_schedulers = [
    "Automatic",
    "Karras",
    "Exponential",
    "Polyexponential"
]

# 机器人相关配置
[bot]

# 机器人的外观描述（用于自画像功能）
appearance_description = "a cute anime girl with blue hair and blue eyes, smiling, wearing a white dress"

# 角色标签智能检索（供 character_tag_lookup Tool 使用）
[tag_retrieval]
enabled = true
# 规划前识别角色并注入事实，会增加一次 MaiBot 工具模型调用
prefetch_before_plan = true
# 仅在本地运行配置填写；留空时只查询 SQLite，不请求向量与重排服务
api_key = ""
embedding_url = "https://api.siliconflow.cn/v1/embeddings"
embedding_model = "Qwen/Qwen3-Embedding-4B"
rerank_url = "https://api.siliconflow.cn/v1/rerank"
rerank_model = "Qwen/Qwen3-Reranker-4B"
timeout = 60
batch_size = 32
candidate_count = 30
min_similarity = 0.45
min_rerank_score = 0.3
rerank_enabled = true
